# Copy this file to `.env` and fill in real values.
#   cp .env.example .env
# Never commit `.env` — it is gitignored.
#
# Feed the file to Flutter at build/run time (Flutter 3.16+):
#   flutter run  --dart-define-from-file=.env
#   flutter build apk --release --dart-define-from-file=.env

# Google OAuth 2.0 Web client id (Google Cloud Console) used by the
# Google Calendar "Save Day" feature. Empty = feature disabled with a clear error.
GOOGLE_CLIENT_ID=

# Backend base URL. Omit to use the public API
# (https://dayskew.danailmihov.com/api). Local dev on an Android emulator:
# http://10.0.2.2:8080
# API_BASE_URL=http://10.0.2.2:8080
